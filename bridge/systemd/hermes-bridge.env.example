# hermes-bridge.env — environment for the systemd unit (EnvironmentFile).
# Copy to hermes-bridge.env and fill in. All keys use the BRIDGE_ prefix
# (see bridge/config.py). Keep this file readable only by the hermes user:
#   chmod 600 hermes-bridge.env

# Shared localhost secret for POST /internal/ui. MUST match the value the
# Hermes plugin reads (BRIDGE_INTERNAL_TOKEN in the agent's env).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
BRIDGE_INTERNAL_TOKEN=replace-with-32-byte-hex

# Public tunnel URL baked into pairing QR codes (your cloudflared hostname).
BRIDGE_PUBLIC_URL=wss://hermes.example.com

# --- Optional overrides (defaults shown) -----------------------------------
# BRIDGE_HERMES_URL=http://127.0.0.1:4700
# BRIDGE_MAX_UPLOAD_BYTES=52428800
# BRIDGE_WS_RATE_LIMIT_PER_MIN=600
# BRIDGE_WS_CONNECT_RATE_LIMIT_PER_MIN=60
# BRIDGE_INTERNAL_RATE_LIMIT_PER_MIN=600
# BRIDGE_TTS_VOICE=en-US-AriaNeural
